---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import { site } from '@/data/site';
---
<Base title="Page not found" description="That page is not here. Try the services, industries or contact pages, or call us." noindex>
  <PageHero eyebrow="404" title="That page isn't here." lede="It may have moved when we rebuilt the site. Try one of these instead." />
  <section class="section section--tight"><div class="container cluster">
    <a class="btn btn--primary" href="/">Home</a>
    <a class="btn btn--secondary" href="/services/">Services</a>
    <a class="btn btn--secondary" href="/contact/">Contact</a>
    <a class="btn btn--secondary" href={`tel:${site.phoneHref}`}>Call {site.phone}</a>
  </div></section>
</Base>
