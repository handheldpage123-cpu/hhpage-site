---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Cta from '@/components/Cta.astro';
import { getCollection } from 'astro:content';
import { breadcrumbs } from '@/lib/schema';
import { site } from '@/data/site';
const studies = (await getCollection('caseStudies', ({ data }) => !data.draft && !data.placeholder)).sort((a, b) => a.data.order - b.data.order);
const industries = await getCollection('industries');
const industryName = (slug: string) => industries.find((i) => i.id === slug)?.data.shortName ?? slug;
const title = 'Our work';
const description = 'Case studies from dental, orthodontic and medical practices: what we changed, what it cost, and what happened to the numbers.';
---
<Base title={title} description={description} schema={[breadcrumbs([{ name: 'Home', url: site.url + '/' }, { name: 'Work', url: site.url + '/work/' }])]} markdownPath="/work/index.md">
  <PageHero crumbs={[{ name: 'Work', href: '/work/' }]} eyebrow="Work" title="What happened to the numbers." lede="Every case study shows the before, the after, and what we did in between. Numbers come from Semrush, Google Analytics and the practice's Google Business Profile." />
  <section class="section section--tight">
    <div class="container">
      {studies.length === 0 ? (
        <div class="card stack">
          <h2 class="h3">Case studies are being written up now</h2>
          <p class="meta">We work with 100+ practices and are collecting before-and-after numbers for the first set. In the meantime, ask us on a call and we will walk you through a practice like yours.</p>
          <a class="btn btn--primary" href={site.primaryCta.href}>{site.primaryCta.label}</a>
        </div>
      ) : (
        <div class="grid grid--2">
          {studies.map((c) => {
            const featured = c.data.takeaways.find((t) => t.featured);
            return (
              <a class="card card--link study" href={`/work/${c.id}/`}>
                {c.data.screenshot && <img class="study__shot" src={c.data.screenshot} alt="" width="1568" height="680" loading="lazy" decoding="async" />}
                <p class="eyebrow">{industryName(c.data.industry)}{c.data.location ? ` · ${c.data.location}` : ''}</p>
                {c.data.logo && <span class="study__logo"><img src={c.data.logo} alt="" loading="lazy" decoding="async" /></span>}
                <h2 class="h3">{c.data.client}</h2>
                {featured && <p class="study__stat">{featured.headline}</p>}
                <p class="meta">{c.data.summary}</p>
                <span class="more">Read the case study →</span>
              </a>
            );
          })}
        </div>
      )}
    </div>
  </section>
  <Cta />
</Base>
<style>
  .h3 { font-size: var(--text-xl); }
  .study__shot { display: block; width: 100%; height: auto; border: 1px solid var(--line); border-radius: var(--radius); }
  .study__logo { display: inline-grid; place-items: center; background: #FFFFFF; border: 1px solid var(--line); border-radius: var(--radius-sm); padding: var(--space-2) var(--space-3); justify-self: start; }
  .study__logo img { max-width: 160px; max-height: 56px; width: auto; height: auto; display: block; }
  .study__stat { font-family: var(--font-display); font-size: var(--text-lg); font-weight: 700; color: var(--blue); }
</style>
