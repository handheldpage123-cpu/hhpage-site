---
import Base from '@/layouts/Base.astro';
import ProofBar from '@/components/ProofBar.astro';
import LeadForm from '@/components/LeadForm.astro';
import Cta from '@/components/Cta.astro';
import Faqs from '@/components/Faqs.astro';
import { site } from '@/data/site';
import { getCollection } from 'astro:content';
import { faqPage } from '@/lib/schema';

const services = (await getCollection('services', ({ data }) => !data.draft && data.featured)).sort((a, b) => a.data.order - b.data.order);
const industries = (await getCollection('industries', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const faqs = (await getCollection('faqs')).sort((a, b) => a.data.order - b.data.order).map((f) => ({ q: f.data.question, a: f.data.answer }));

const title = site.name;
const description = site.description;
---
<Base title={title} description={description} schema={[faqPage(faqs)]} markdownPath="/index.md">
  <section class="hero">
    <img class="hero__photo" src="/images/placeholder-hero-office.webp" srcset="/images/placeholder-hero-office-768.webp 768w, /images/placeholder-hero-office.webp 1536w" sizes="100vw" width="1536" height="1024" alt="" fetchpriority="high" decoding="async" />
    <div class="container hero__inner">
      <div class="hero__copy stack">
        <h1>Book a strategy call. Leave with a plan and a price.</h1>
        <p class="hero__lede">Websites, SEO and Google Ads for dental, orthodontic and medical practices.</p>
        <ul class="hero__checks">
          <li>Where your new patients come from now</li>
          <li>The two or three changes that matter most</li>
          <li>What each would cost, in writing</li>
        </ul>
        <p class="hero__jump"><a class="btn btn--primary" href="#strategy-call">{site.primaryCta.label}</a></p>
        <p class="hero__call">Or call <a href={`tel:${site.phoneHref}`}>{site.phone}</a>, Monday to Friday, 8am to 5pm Central.</p>
      </div>
      <div class="hero__form card" id="strategy-call">
        <LeadForm kind="contact" variant="short" location="home_hero" heading="Request a strategy call" submitLabel={site.primaryCta.label} />
      </div>
    </div>
    <p class="hero__tag">Placeholder photo: client office</p>
  </section>

  <ProofBar />

  <section class="section section--tight">
    <div class="container deal">
      <h2>The deal</h2>
      <ul>
        <li>Clear pricing, agreed before work starts.</li>
        <li>Month-to-month on monthly services.</li>
        <li>You talk to the people doing the work.</li>
        <li>You own your website and your data.</li>
        <li>Real support, Monday to Friday.</li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Services</p>
        <h2>A few things move a practice's numbers. We do those well.</h2>
        <p class="lede">Most practices start with our Essentials plan (website hosting and management, listings, reviews on your site, accessibility) and add Google Ads or advanced review management when the numbers justify it.</p>
      </div>
      <div class="grid grid--3">
        {services.map((s) => (
          <a class="card card--link" href={`/services/${s.id}/`}>
            <h3>{s.data.shortName}</h3>
            <p class="meta">{s.data.summary}</p>
            <span class="more">Learn more →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--band">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Industries</p>
        <h2>Built for the way patients find a practice</h2>
        <p class="lede">We have run the same playbooks for fifteen years in healthcare. Pick your specialty for what works there.</p>
      </div>
      <div class="grid grid--3">
        {industries.map((i) => (
          <a class="card card--link" href={`/industries/${i.id}/`}>
            <h3>{i.data.shortName}</h3>
            <p class="meta">{i.data.summary}</p>
            <span class="more">See the playbook →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid grid--2 why">
        <div class="stack">
          <p class="eyebrow">Why practices switch to us</p>
          <h2>Marketing is simpler than most agencies make it look.</h2>
          <p>A fast site with a page per treatment, an active Google profile, consistent listings, a steady flow of reviews, and ads only where the margins justify them. We do those well and skip the rest. We are transparent about what is working and what is not, and we let you make the spending decisions with that in front of you.</p>
          <p><a href="/how-we-work/">Read how we work →</a></p>
        </div>
        <div class="card stack">
          <h3>What a first call covers</h3>
          <ol>
            <li>Where your new patients come from now, as far as the data shows.</li>
            <li>What your site, listings and reviews look like next to the practice down the street.</li>
            <li>The two or three changes most likely to move the number.</li>
            <li>What each would cost, in writing.</li>
          </ol>
          <a class="btn btn--primary" href={site.primaryCta.href}>{site.primaryCta.label}</a>
        </div>
      </div>
    </div>
  </section>

  <Faqs items={faqs} />
  <Cta />
</Base>

<style>
  /* Booking-first hero: text sits on a fixed navy tint over the photo, so it reads the same in light and dark themes. */
  .hero { position: relative; isolation: isolate; background: var(--navy); color: var(--on-navy); padding-block: var(--space-12); overflow: hidden; }
  .hero__photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
  .hero::before { content: ""; position: absolute; inset: 0; z-index: -1; background: var(--navy); opacity: 0.76; }
  .hero__inner { display: grid; gap: var(--space-8); align-items: center; }
  @media (min-width: 900px) { .hero { padding-block: var(--space-16); } .hero__inner { grid-template-columns: 1.1fr 0.9fr; gap: var(--space-12); } }
  .hero h1 { color: var(--on-navy); max-width: 16ch; }
  .hero__lede { font-size: var(--text-lg); color: var(--on-navy); max-width: 34ch; }
  .hero__checks { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-3); font-weight: 600; }
  .hero__checks li { position: relative; padding-left: 2rem; }
  .hero__checks li::before { content: ""; position: absolute; left: 0.2rem; top: 0.3em; width: 0.5rem; height: 0.95rem; border: solid var(--accent-on-navy); border-width: 0 3px 3px 0; transform: rotate(45deg); }
  .hero__call { color: var(--on-navy-muted); font-size: var(--text-sm); }
  .hero__call a { color: var(--on-navy); font-weight: 600; }
  .hero__jump { margin: 0; }
  .hero__copy a:focus-visible { outline-color: var(--on-navy); }
  @media (min-width: 900px) { .hero__jump { display: none; } }
  .hero__form { color: var(--ink); scroll-margin-top: 88px; box-shadow: var(--shadow); }
  .hero__form :global(h2) { font-size: var(--text-xl); }
  .hero__form :global(.btn) { width: 100%; justify-content: center; }
  .hero__form :global(.cluster) { display: grid; }
  .hero__tag { position: absolute; left: var(--gutter); bottom: var(--space-2); margin: 0; font-size: var(--text-xs); color: var(--on-navy-muted); }
  .deal { display: grid; gap: var(--space-4); }
  .deal h2 { font-size: var(--text-xl); }
  .deal ul { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-3) var(--space-8); grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); font-weight: 600; }
  .deal li { padding-left: var(--space-4); border-left: 3px solid var(--accent); }
  .why ol { padding-left: 1.25em; display: grid; gap: var(--space-2); }
</style>
