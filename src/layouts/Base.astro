---
import '@/styles/global.css';
import { site } from '@/data/site';
import { graph, organization, website, webPage } from '@/lib/schema';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Analytics from '@/components/Analytics.astro';

interface Props {
  title: string;
  description: string;
  /** Extra JSON-LD nodes for this page (Service, FAQPage, Article...). */
  schema?: (object | null | undefined)[];
  datePublished?: Date;
  dateModified?: Date;
  ogImage?: string;
  noindex?: boolean;
  /** Path of the Markdown twin of this page, linked for AI agents. */
  markdownPath?: string;
}

const { title, description, schema = [], datePublished, dateModified, ogImage, noindex = false, markdownPath } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const fullTitle = title === site.name ? `${site.name} | ${site.shortName}` : `${title} | ${site.shortName}`;
const og = new URL(ogImage ?? '/og-default.png', site.url).href;
const jsonLd = graph(
  organization(),
  website(),
  webPage({ url: canonical, name: title, description, datePublished, dateModified }),
  ...schema,
);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#F4F6FB" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0D1220" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {markdownPath && <link rel="alternate" type="text/markdown" href={markdownPath} />}
    <!-- Fonts: Google Fonts for Phase 1; self-hosted subset is a Phase 2 item (DECISIONS.md). -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@600;700&family=Figtree:wght@400;600&family=IBM+Plex+Mono:wght@500&display=swap" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Analytics />
    <!-- EqualBrowse accessibility widget (Q14). Deferred so it never blocks render. -->
    <script src={site.equalBrowseScript} defer is:inline></script>
    <script>
      // Scroll reveal + count-up. Progressive: without JS nothing is hidden.
      document.documentElement.classList.add('js');
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          e.target.classList.add('is-in');
          e.target.querySelectorAll<HTMLElement>('[data-count]').forEach(countUp);
          if (e.target.hasAttribute('data-count')) countUp(e.target as HTMLElement);
          io.unobserve(e.target);
        }
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.12 });
      document.querySelectorAll('.reveal, [data-count]').forEach((el) => io.observe(el));
      function countUp(el: HTMLElement) {
        if (el.dataset.done) return; el.dataset.done = '1';
        const end = Number(el.dataset.count); if (!Number.isFinite(end) || reduce) { el.textContent = String(end); return; }
        const t0 = performance.now(), dur = 1100;
        const tick = (t: number) => { const p = Math.min(1, (t - t0) / dur), e = 1 - Math.pow(1 - p, 3); el.textContent = Math.round(end * e).toLocaleString(); if (p < 1) requestAnimationFrame(tick); };
        requestAnimationFrame(tick);
      }
    </script>
  </body>
</html>

<style is:global>
  .skip { position: absolute; left: -9999px; top: 0; background: var(--ink); color: var(--paper); padding: 0.75rem 1rem; z-index: 100; border-radius: 0 0 var(--radius) 0; }
  .skip:focus { left: 0; }
</style>
