---
interface Props { items: { name: string; href: string }[] }
const { items } = Astro.props;
---
<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    <li><a href="/">Home</a></li>
    {items.map((it, i) => (i === items.length - 1 ? <li aria-current="page">{it.name}</li> : <li><a href={it.href}>{it.name}</a></li>))}
  </ol>
</nav>
