---
import { site } from '@/data/site';
import { getCollection } from 'astro:content';
const services = (await getCollection('services', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const industries = (await getCollection('industries', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <div class="site-footer__about">
        <p class="site-footer__brand">{site.name}</p>
        <p class="site-footer__tag">{site.tagline}</p>
        <p class="site-footer__contact">
          <a href={`tel:${site.phoneHref}`}>{site.phone}</a><br />
          <a href={`mailto:${site.email}`}>{site.email}</a><br />
          <span>Support 7 days a week · Serving practices across the US</span>
        </p>
      </div>
      <nav aria-label="Services">
        <h2 class="site-footer__h">Services</h2>
        <ul>{services.map((s) => <li><a href={`/services/${s.id}/`}>{s.data.shortName}</a></li>)}</ul>
      </nav>
      <nav aria-label="Industries">
        <h2 class="site-footer__h">Industries</h2>
        <ul>{industries.map((i) => <li><a href={`/industries/${i.id}/`}>{i.data.shortName}</a></li>)}</ul>
      </nav>
      <nav aria-label="Company">
        <h2 class="site-footer__h">Company</h2>
        <ul>
          {site.nav.filter((n) => !['/services/', '/industries/'].includes(n.href)).map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          {site.footerNav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        </ul>
      </nav>
    </div>
    <p class="site-footer__legal">© {year} {site.legalName}. {site.name} ({site.shortName}). <a href="/llms.txt">llms.txt</a></p>
  </div>
</footer>

<style>
  .site-footer { background: var(--surface); border-top: 1px solid var(--line); padding-block: var(--space-16) var(--space-8); margin-top: var(--space-16); font-size: var(--text-sm); }
  .site-footer__grid { display: grid; gap: var(--space-8); grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); }
  .site-footer__about { grid-column: span 1; display: grid; gap: var(--space-3); align-content: start; }
  @media (min-width: 900px) { .site-footer__about { max-width: 36ch; } .site-footer__grid { grid-template-columns: 1.8fr 1fr 1fr 1fr; } }
  .site-footer__brand { font-family: var(--font-display); font-weight: 700; font-size: var(--text-lg); }
  .site-footer__tag { color: var(--muted); }
  .site-footer__contact { line-height: 1.8; }
  .site-footer__h { font-size: var(--text-xs); letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); font-family: var(--font-mono); font-weight: 500; margin-bottom: var(--space-3); }
  .site-footer ul { list-style: none; padding: 0; display: grid; gap: var(--space-2); }
  .site-footer a { color: var(--ink); text-decoration: none; }
  .site-footer a:hover { text-decoration: underline; }
  .site-footer__legal { margin-top: var(--space-12); color: var(--muted); padding-top: var(--space-4); border-top: 1px solid var(--line); }
  .site-footer__legal a { color: var(--muted); }
</style>
