---
/**
 * Small inline stroke icons keyed by the `icon` field in content frontmatter
 * (services) or by name. Inherit currentColor so they follow the theme.
 */
interface Props { name: string; size?: number; class?: string }
const { name, size = 24, class: cls = '' } = Astro.props;
const paths: Record<string, string> = {
