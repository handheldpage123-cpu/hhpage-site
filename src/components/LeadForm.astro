---
/**
 * Native form that posts JSON to a GoHighLevel inbound webhook (Q15).
 * No iframe, no GHL script: nothing here affects Lighthouse.
 *
 * GHL setup (Phase 3): Automations → Workflows → new workflow → trigger
 * "Inbound Webhook". Paste the webhook URL into Cloudflare as
 * PUBLIC_GHL_WEBHOOK_CONTACT / PUBLIC_GHL_WEBHOOK_SUPPORT. Map the JSON
 * fields below to contact fields, add the contact to the right pipeline,
 * and send the internal notification (support@hhpage.com for support).
 *
 * Until the webhook URL is set, submissions fall back to a mailto draft so
 * nothing is silently lost.
 */
interface Props {
  kind: 'contact' | 'support';
  heading?: string;
  submitLabel?: string;
}
const { kind, heading, submitLabel = kind === 'support' ? 'Send support request' : 'Submit' } = Astro.props;
// The contact webhook is a public endpoint by design (the browser posts to it), so a
// default lives here; PUBLIC_GHL_WEBHOOK_CONTACT in Cloudflare overrides it.
// GHL workflow: "HHPage Website - Contact Form" in the HHpage sub-account.
const CONTACT_WEBHOOK_DEFAULT = 'https://services.leadconnectorhq.com/hooks/yZOPS0fxvEYgKT5HDKtj/webhook-trigger/9e614483-3948-488a-9864-d91c7a3f2144';
const webhook = kind === 'support' ? import.meta.env.PUBLIC_GHL_WEBHOOK_SUPPORT : (import.meta.env.PUBLIC_GHL_WEBHOOK_CONTACT || CONTACT_WEBHOOK_DEFAULT);
const id = `form-${kind}`;
// Suggestions only: the field is free text so any specialty can be entered.
const specialties = ['General dentistry', 'Orthodontics', 'Pediatric dentistry', 'Oral surgery', 'Periodontics', 'Endodontics', 'Prosthodontics', 'Dermatology', 'Family medicine', 'Orthopedics', 'Pulmonology', 'Gastroenterology', 'Emergency medicine'];
---
<form class="form" id={id} data-kind={kind} data-webhook={webhook ?? ''} novalidate>
  {heading && <h2>{heading}</h2>}
  {kind === 'support' ? (
    <>
      <div class="grid grid--2">
        <div class="field">
          <label for={`${id}-name`}>Your name</label>
          <input id={`${id}-name`} name="name" type="text" autocomplete="name" required />
        </div>
        <div class="field">
          <label for={`${id}-practice`}>Practice or business</label>
          <input id={`${id}-practice`} name="practice" type="text" autocomplete="organization" />
        </div>
        <div class="field">
          <label for={`${id}-email`}>Email</label>
          <input id={`${id}-email`} name="email" type="email" autocomplete="email" inputmode="email" required />
        </div>
        <div class="field">
          <label for={`${id}-phone`}>Phone <span class="hint">(optional)</span></label>
          <input id={`${id}-phone`} name="phone" type="tel" autocomplete="tel" inputmode="tel" />
        </div>
      </div>
      <div class="field">
        <label for={`${id}-topic`}>What do you need help with?</label>
        <select id={`${id}-topic`} name="topic" required>
          <option value="">Choose one</option>
          <option>Website change or bug</option>
          <option>Hosting, domain or email</option>
          <option>Google Ads or Local Services Ads</option>
          <option>Google Business Profile or listings</option>
          <option>Reviews</option>
          <option>Billing or account</option>
          <option>Something else</option>
        </select>
      </div>
      <div class="field">
        <label for={`${id}-message`}>Tell us what is happening</label>
        <textarea id={`${id}-message`} name="message" required></textarea>
        <span class="hint">Include the page URL if it is about your website.</span>
      </div>
    </>
  ) : (
    <>
      <div class="grid grid--2">
        <div class="field">
          <label for={`${id}-name`}>Name</label>
          <input id={`${id}-name`} name="name" type="text" autocomplete="name" required />
        </div>
        <div class="field">
          <label for={`${id}-practice`}>Practice name</label>
          <input id={`${id}-practice`} name="practice" type="text" autocomplete="organization" required />
        </div>
        <div class="field">
          <label for={`${id}-specialty`}>Medical specialty</label>
          <input id={`${id}-specialty`} name="specialty" type="text" list={`${id}-specialties`} placeholder="e.g. Orthodontics" required />
          <datalist id={`${id}-specialties`}>
            {specialties.map((s) => <option value={s} />)}
          </datalist>
        </div>
        <div class="field">
          <label for={`${id}-email`}>Email</label>
          <input id={`${id}-email`} name="email" type="email" autocomplete="email" inputmode="email" required />
        </div>
        <div class="field">
          <label for={`${id}-phone`}>Phone</label>
          <input id={`${id}-phone`} name="phone" type="tel" autocomplete="tel" inputmode="tel" required />
        </div>
        <div class="field">
          <label for={`${id}-url`}>Practice URL <span class="hint">(optional)</span></label>
          <input id={`${id}-url`} name="practice_url" type="text" autocomplete="url" inputmode="url" placeholder="yourpractice.com" />
        </div>
      </div>
      <fieldset class="choices">
        <legend>Best way to communicate</legend>
        <div class="cluster">
          <label><input type="radio" name="preferred_contact" value="Phone" required /> Phone</label>
          <label><input type="radio" name="preferred_contact" value="Text" /> Text</label>
          <label><input type="radio" name="preferred_contact" value="Email" /> Email</label>
        </div>
      </fieldset>
      <div class="field">
        <label for={`${id}-message`}>How can we help you?</label>
        <textarea id={`${id}-message`} name="message" required></textarea>
      </div>
    </>
  )}
  <div class="hp" aria-hidden="true"><label>Leave this empty<input name="website_url" type="text" tabindex="-1" autocomplete="off" /></label></div>
  <div class="cluster">
    <button class="btn btn--primary" type="submit">{submitLabel}</button>
    <p class="form__status" role="status" aria-live="polite"></p>
  </div>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('form[data-kind]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('.form__status')!;
    const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.dataset.state = '';
      if (!form.reportValidity()) return;
      const data = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
      if (data.website_url) return; // honeypot
      delete data.website_url;
      // Bare domains are fine to type; store a full URL for the CRM.
      if (data.practice_url && !/^https?:\/\//i.test(data.practice_url)) data.practice_url = `https://${data.practice_url.trim()}`;
      const [first_name, ...rest] = (data.name ?? '').trim().split(/\s+/);
      data.first_name = first_name ?? '';
      data.last_name = rest.join(' ');
      const payload = { ...data, form_name: form.dataset.kind, page: location.href, submitted_at: new Date().toISOString() };
      const webhook = form.dataset.webhook;
      button.disabled = true;
      status.textContent = 'Sending…';
      try {
        if (webhook) {
          const res = await fetch(webhook, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
          if (!res.ok) throw new Error(String(res.status));
        } else {
          // Fallback until the GHL webhook is configured.
          const body = Object.entries(payload).map(([k, v]) => `${k}: ${v}`).join('\n');
          location.href = `mailto:support@hhpage.com?subject=${encodeURIComponent(`${form.dataset.kind} form`)}&body=${encodeURIComponent(body)}`;
        }
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: 'form_submit', form_name: form.dataset.kind });
        if (window.gtag) window.gtag('event', 'form_submit', { form_name: form.dataset.kind });
        // Contact leads land on the confirmation page once GHL has accepted the post.
        if (webhook && form.dataset.kind === 'contact') { location.assign('/contact/thank-you/'); return; }
        status.dataset.state = 'ok';
        status.textContent = form.dataset.kind === 'support' ? 'Got it. We reply within one business day, usually faster.' : 'Thanks. We will be in touch within one business day.';
        form.reset();
      } catch {
        status.dataset.state = 'error';
        status.textContent = 'That did not go through. Email support@hhpage.com or call (832) 409-0868.';
      } finally {
        button.disabled = false;
      }
    });
  });
  declare global { interface Window { dataLayer: unknown[]; gtag?: (...args: unknown[]) => void } }
</script>

<style>
  .choices { border: 0; padding: 0; margin: 0; display: grid; gap: var(--space-2); }
  .choices legend { font-weight: 600; font-size: var(--text-sm); padding: 0; margin-bottom: var(--space-2); }
  .choices label { display: inline-flex; align-items: center; gap: var(--space-2); min-height: 44px; padding-right: var(--space-3); cursor: pointer; }
  .choices input { width: 1.15rem; height: 1.15rem; accent-color: var(--blue); }
</style>
