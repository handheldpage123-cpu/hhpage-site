---
interface Props { items: { q: string; a: string }[]; title?: string; }
const { items, title = 'Questions people ask' } = Astro.props;
---
{items.length > 0 && (
  <section class="section section--tight">
    <div class="container">
      <div class="section-head"><h2>{title}</h2></div>
      <div>
        {items.map((f) => (
          <details class="faq">
            <summary>{f.q}</summary>
            <div class="faq__body"><p>{f.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>
)}
