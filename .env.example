# Copy to .env for local dev. Production values live in Cloudflare (Workers & Pages → Settings → Variables).
# GoHighLevel inbound webhook URLs (Automations → Workflows → Inbound Webhook trigger). PUBLIC_ because the static form posts from the browser.
PUBLIC_GHL_WEBHOOK_CONTACT=
PUBLIC_GHL_WEBHOOK_SUPPORT=
# GoHighLevel calendar embed URL for /book/
PUBLIC_GHL_CALENDAR_URL=
